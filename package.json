{
  "name": "pi-extensions",
  "version": "1.0.0",
  "description": "Custom pi extensions: agent modes, roleplay tools, session viewer, undo/redo, web search/fetch, and wiki tools",
  "private": true,
  "keywords": ["pi-package"],
  "workspaces": ["extensions/*"],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.7.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": ["extensions"],
    "skills": ["extensions/pi-modes/skills"]
  }
}
